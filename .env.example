# GEMINI_API_KEY: Provided by Google AI Studio runtime or manually for server-side AI debugging
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional OpenRouter API Key for Qwen2.5 Coder 32B Instruct model
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# OPENROUTER_MODEL: Target AI model ID on OpenRouter (default: qwen/qwen-2.5-coder-32b-instruct)
OPENROUTER_MODEL="qwen/qwen-2.5-coder-32b-instruct"

# AI_PROVIDER: Preferred default AI provider ('gemini' or 'openrouter')
AI_PROVIDER="gemini"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT=3000

